# Copia este archivo como .env y complétalo.

# Clave para firmar sesiones. Genera una con: openssl rand -base64 48
SECRET_KEY=

DOMAIN=3dvault.miempresa.com
MAX_FILE_SIZE_GB=20
# Horas que dura una sesión. 168 (una semana) evita escribir la contraseña cada día
# a quien abre 3D-Vault al iniciar Windows.
SESSION_HOURS=168

# Opcional: IP o rangos permitidos, separados por comas. Vacío permite cualquiera.
ALLOWED_IPS=

# Zona horaria de las fechas de la web y de la hora de las copias, por ejemplo
# America/Santiago.
TZ=UTC

# Carpeta del VPS para las copias. Monta aquí un destino FUERA del VPS: una copia
# que vive en la misma máquina no sobrevive a perder la máquina.
BACKUP_PATH=/mnt/copias/3d-vault

# Copia de seguridad diaria, hecha por el propio servidor a la hora BACKUP_HOUR
# (0 a 23, hora de TZ). BACKUP_DIR es la carpeta dentro del contenedor: /backup es
# BACKUP_PATH. Vacía, no hay copias automáticas. Se conserva solo la última copia:
# cada noche añade los trozos nuevos y reemplaza la base de datos.
BACKUP_DIR=/backup
BACKUP_HOUR=3
